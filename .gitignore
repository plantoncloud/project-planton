.idea
.DS_Store
# Python bytecode from the _rules/ workflow scripts
__pycache__/
generated/
# Rendered InfraChart output from `planton chart build` (chart-root artifact)
charts/*/*/template.yaml
# Helm dependency archives vendored by `helm dependency build` (Chart.lock IS committed)
helm/*/charts/
build/
bin/
# Website (site/) dependency, build, and toolchain artifacts: Next.js static
# export output, the Yarn Berry cache, and files every `make -C site build`
# regenerates (next-env.d.ts, the recent-changelog JSON). Nested .gitignore
# files inside site/ (e.g. the R2 image inbox) handle their own local zones.
site/node_modules/
site/.next/
site/out/
site/build/
site/coverage/
site/.yarn/*
!site/.yarn/patches
!site/.yarn/plugins
!site/.yarn/releases
!site/.yarn/versions
site/.pnp.*
site/next-env.d.ts
site/*.tsbuildinfo
site/.env*
site/public/changelog/recent.json
site/.venv/
# Pinned proto toolchain, provisioned by `make proto-tools`
.tools/

# Terraform init/plan/apply artifacts (generated locally, never committed)
**/.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
terraform.tfplan
*.tfplan
*.tfvars
# Bazel output symlinks. Bazel names the convenience symlink after the workspace
# directory (bazel-<dirname>), so a per-clone-name list can never be complete --
# the glob covers every clone name. The tracked wrapper `bazelw` has no hyphen and
# is not matched.
bazel-*
# All Pulumi stack files, including transient E2E stacks (Pulumi.e2e-*.yaml)
# left behind by aborted harness runs. Only the project file Pulumi.yaml is tracked.
Pulumi.*.yaml
!Pulumi.yaml
test-*.log
.cursor/workspace/
cursor/
.git-ignored/
**/iac/pulumi/pulumi
_cursor/
_a-gitignored-workspace

# Web-app generated files
web-app/src/gen/

*.sh
!app/entrypoint-unified.sh
!tools/ci/release/package_content.sh
# CI pipeline scripts must be tracked (referenced by .github/workflows/ and
# the Makefile -- an ignored script exists only on the machine that wrote it
# and breaks every fresh checkout).
!tools/ci/**/*.sh
# CI guard scripts must be tracked (run by .github/workflows/lint.*.yaml)
!hack/guards/*.sh
# Scenario SETUP-phase scripts (see e2e/README.md). The blanket *.sh
# ignore would otherwise leave them only on the machine that wrote them
# and break every fresh checkout's lane.
!catalog/**/e2e/scenarios/*.setup.sh
# Real-cluster batch runbooks (see catalog/kubernetes/aa_e2e/realcluster/):
# bootstrap/teardown/audit scripts ARE the runbook. The blanket ignore left
# the aws-eks batch's scripts on the machine that wrote them, so that batch
# was documented but not reproducible from a checkout.
!catalog/kubernetes/aa_e2e/realcluster/**/*.sh
**/*.env
# Local-only provider credentials for live E2E (see forge rule "Post-Forge Live
# E2E Validation"). NEVER commit. Note **/*.env above does not match *.env.e2e.
**/.env.e2e
**/*.env.e2e
_aacursor/
backend.tf
/pulumi

# E2E test artifacts (generated during pulumi runs)
**/iac/pulumi/stack-input.yaml

# `go build .` at the repo root produces a binary named after the package (main)
/main

# Local upstream clones used as design-time reference material — disposable,
# re-cloned on demand, never committed.
/source_reference/
.bin/
