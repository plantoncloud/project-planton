{
  "name": "planton-ai",
  "packageManager": "yarn@3.8.7",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build:packages": "yarn workspace @planton/website-shell build",
    "build": "node scripts/check-displayed-vs-enforced.mjs && yarn build:packages && node scripts/generate-recent-changelog.mjs && next build && pagefind --site out --output-path out/_pagefind --exclude-selectors 'pre,code'",
    "check:displayed-vs-enforced": "node scripts/check-displayed-vs-enforced.mjs",
    "start": "next start",
    "lint": "eslint ."
  },
  "dependencies": {
    "@calcom/embed-react": "^1.5.3",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.2.1",
    "@mui/material": "^6.2.1",
    "@mui/material-nextjs": "^6.2.1",
    "@next/third-parties": "^16.2.1",
    "@svgr/webpack": "^8.1.0",
    "@types/mermaid": "^9.2.0",
    "canvas-confetti": "^1.9.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.542.0",
    "mermaid": "^11.10.1",
    "next": "16.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "swiper": "^11.2.4",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@swc/core": "^1.13.5",
    "@swc/helpers": "^0.5.17",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "pagefind": "^1.4.0",
    "postcss": "^8",
    "puppeteer": "^24.36.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "yaml": "^2.9.0"
  }
}
